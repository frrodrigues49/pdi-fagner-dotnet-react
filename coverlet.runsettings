<?xml version="1.0" encoding="utf-8"?>
<!-- Uso: dotnet test com settings coverlet.runsettings e collect "XPlat Code Coverage" (ver README) -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Só código de produção da solution -->
          <Include>[Pdi.Onboarding.Api]*,[Pdi.Antifraude.Api]*,[Pdi.Onboarding.Worker]*,[Pdi.Onboarding.Contracts]*</Include>
          <!-- Migrations são geradas pelo `dotnet ef`, não escritas à mão -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
